# Copy to .env and fill in.

# LLM: combined as "<provider>:<model>" for LangChain's init_chat_model.
# Default: Gemini on a free Google AI Studio key (https://aistudio.google.com/apikey).
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=
# Tried in order when a call to LLM_MODEL fails (e.g. a 429 when its free-tier quota runs out, or a 503).
# Same provider as LLM_MODEL. Each Gemini model has its own free-tier quota. [] turns the fallback off.
LLM_FALLBACK_MODELS=["gemini-3.5-flash-lite"]
# Fail fast when the model is busy: seconds per LLM call, and retries after a failure.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# LLM calls allowed per question (a normal one uses 2). Keeps a question within Gemini's free-tier limits.
MAX_LLM_CALLS=5

# Other providers are switched off by default. To use one, install its extra
# (uv sync --extra anthropic) and set the provider, model and key instead:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# BigQuery: queries are billed to this project.
GCP_PROJECT=
# Optional: a service-account key file. Without it, gcloud Application Default Credentials are used.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# Hard cap on bytes billed per query (1 GB).
MAX_BYTES_BILLED=1000000000

# The secret behind customer pseudonyms: the model sees cust_72ac84091163, never a real customer id.
# Keep it secret like an API key. Set it to keep the same pseudonyms across runs; left empty, a random
# one is made at startup, so pseudonyms stay the same within a run but change between runs.
PSEUDONYM_SALT=

# Totals of demographic columns (age, gender, city, state, country, traffic source) over fewer
# customers than this are hidden, so a small group can't point to one person.
MIN_GROUP_SIZE=5

# Max rows of a query result sent to the model.
MAX_ROWS=50

# Tracing (step 6), optional: uncomment to send each question to LangSmith (https://smith.langchain.com) as one
# trace: LLM calls, tool calls, the SQL BigQuery ran after the gateway's rewrites, rows, timing and tokens, labelled
# with the user, brands, model and conversation. Traces hold prompts, SQL and (already masked) result rows.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=retail-data-agent
# Only for an EU LangSmith account:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

SCHEMA_PATH=config/schema.yaml
# Saved reports: a SQLite file, created on the first report.
REPORTS_PATH=data/reports.sqlite3
PROMPT_PATH=prompts/system.md

# Who can use the agent and which brands each one sees (pick one with --user).
USERS_PATH=config/users.yaml
