# Copy to .env and fill in.

# LLM: combined as "<provider>:<model>" for LangChain's init_chat_model.
# Default: Gemini on a free Google AI Studio key (https://aistudio.google.com/apikey).
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=
# Tried in order when a call to LLM_MODEL fails (e.g. a 429 when its free-tier quota runs out, or a 503).
# Same provider as LLM_MODEL. Each Gemini model has its own free-tier quota. [] turns the fallback off.
LLM_FALLBACK_MODELS=["gemini-3.5-flash-lite"]
# Fail fast when the model is busy: seconds per LLM call, and retries after a failure.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# LLM calls allowed per question (a normal one uses 2). Keeps a question within Gemini's free-tier limits.
MAX_LLM_CALLS=5

# Other providers are switched off by default. To use one, install its extra
# (uv sync --extra anthropic) and set the provider, model and key instead:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# BigQuery: queries are billed to this project.
GCP_PROJECT=
# Optional: a service-account key file. Without it, gcloud Application Default Credentials are used.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# Hard cap on bytes billed per query (1 GB).
MAX_BYTES_BILLED=1000000000

# Max rows of a query result sent to the model.
MAX_ROWS=50

# Tracing (step 6): uncomment to send traces to LangSmith (https://smith.langchain.com).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=retail-data-agent

SCHEMA_PATH=schema.yaml
PROMPT_PATH=prompts/system.md
